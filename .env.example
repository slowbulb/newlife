# Supabase project settings → API.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# service_role key — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Same project, but the public/anon key — used client-side for realtime
# subscriptions only (the gutter/canvas updating live as classification
# finishes). All writes still go through Server Actions with the service key.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Required for classification (both passes) — without it, captures land as
# `unsorted` and stay that way until you set this and resubmit.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
